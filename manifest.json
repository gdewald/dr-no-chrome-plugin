{
  "manifest_version": 3,
  "name": "Dr. No — Medical Search Blocker",
  "version": "1.0.0",
  "description": "Stops you from googling your symptoms or spiraling on WebMD — with a friendly little ASCII friend.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_start",
      "js": ["src/data.js", "src/detect.js", "src/block.js"],
      "css": ["src/block.css"]
    }
  ],
  "options_page": "src/options.html",
  "action": {
    "default_title": "Dr. No",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
